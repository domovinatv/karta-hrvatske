# Headeri za statičke datoteke koje Worker NE obrađuje (wrangler.toml →
# run_worker_first ih izuzima). Na rute kroz Worker ovo se ne primjenjuje —
# tamo headere postavlja applyCacheHeaders u public/_worker.js, s ISTIM
# vrijednostima. Promijeniš jedno, promijeni i drugo.

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/data/*
  Cache-Control: public, max-age=3600, must-revalidate
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

/logos/*
  Cache-Control: public, max-age=2592000, immutable
  Access-Control-Allow-Origin: *

/icons/*
  Cache-Control: public, max-age=3600
