<script id="hr-data" type="application/json">__GEOJSON__</script>
<script id="hr-zup-data" type="application/json">__GEOJSON_ZUP__</script>
<script id="hr-drz-data" type="application/json">__GEOJSON_DRZ__</script>

<script>
const data = JSON.parse(document.getElementById('hr-data').textContent);
const zupData = JSON.parse(document.getElementById('hr-zup-data').textContent);
const drzData = JSON.parse(document.getElementById('hr-drz-data').textContent);
const totalArea = __TOTAL_AREA__;

// Register PMTiles for future scaling
const protocol = new pmtiles.Protocol();
maplibregl.addProtocol("pmtiles", protocol.tile);

const STYLE_LIGHT = 'https://tiles.openfreemap.org/styles/positron';
const STYLE_DARK  = 'https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json';

// Initial theme (set synchronously in <head> from localStorage). Default: dark.
const initialTheme = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';

const map = new maplibregl.Map({
  container: 'map',
  style: initialTheme === 'dark' ? STYLE_DARK : STYLE_LIGHT,
  center: [16.5, 44.5],
  zoom: 6.5,
  attributionControl: { compact: true },
  dragRotate: false,
  pitchWithRotate: false,
  touchPitch: false,
});
map.touchZoomRotate.disableRotation();
map.keyboard.disableRotation();
// Disable native context menu on the map canvas (right-click would otherwise show it)
map.getCanvasContainer().addEventListener('contextmenu', e => e.preventDefault());
map.addControl(new maplibregl.NavigationControl({ showCompass: false, visualizePitch: false }), 'bottom-right');
map.addControl(new maplibregl.ScaleControl({ unit: 'metric' }), 'bottom-right');

// Color palettes
const ZUP_COLORS = {};
data.features.forEach(f => { ZUP_COLORS[f.properties.zupanija] = f.properties.color; });

// Type colors (Grad/Općina/Otok)
const TYPE_COLORS = {'Grad':'#d4322f','Općina':'#588b8b','Otok':'#06aed5','Other':'#8d99ae'};

let colorMode = 'zupanija';
let dark = initialTheme === 'dark';
let showZupBorders = true;
let showJlsBorders = true;
let showNaselja = false;
let focusMode = false;
let naseljaLoaded = false;
let naseljaLoading = false;
window._selectedNaselje = null;

function fillColorExpr() {
  if (colorMode === 'type') {
    return ['match', ['get', 'type'],
      'Grad', '#d4322f', 'Općina', '#588b8b', 'Otok', '#06aed5', '#8d99ae'];
  }
  return ['get', 'color'];
}
function lineColorExpr() {
  if (colorMode === 'type') {
    return ['match', ['get', 'type'],
      'Grad', '#d4322f', 'Općina', '#588b8b', 'Otok', '#06aed5', '#8d99ae'];
  }
  return ['case',
    ['boolean', ['feature-state', 'selected'], false], '#ffffff',
    ['get', 'color']];
}

function addJlsLayers() {
  if (map.getSource('hr')) return; // already there
  // Note: data has top-level `id` on each Feature, so we use that natively (no promoteId).
  map.addSource('hr', { type: 'geojson', data });

  map.addLayer({
    id: 'hr-fill', type: 'fill', source: 'hr',
    paint: {
      'fill-color': fillColorExpr(),
      // Hover takes priority over focus-hidden so hovering a neighbouring JLS
      // in focus mode reveals it as a discovery cue (cursor:pointer + faint
      // fill). The layer is never filter-removed in focus mode so clicks on
      // neighbouring JLS still register and switch the focus.
      'fill-opacity': [
        'case',
        ['boolean', ['feature-state', 'hover'], false], 0.5,
        ['boolean', ['feature-state', 'focus_hidden'], false], 0.0,
        ['boolean', ['feature-state', 'selected'], false], 0.75,
        ['boolean', ['feature-state', 'dimmed'], false], 0.08,
        0.40
      ],
    }
  });

  map.addLayer({
    id: 'hr-line', type: 'line', source: 'hr',
    paint: {
      'line-color': lineColorExpr(),
      'line-width': ['case',
        ['boolean', ['feature-state', 'selected'], false], 3,
        ['boolean', ['feature-state', 'hover'], false], 1.8,
        0.6
      ],
      'line-opacity': 0.85
    }
  });

  // Labels at higher zoom only (560 labels at low zoom = chaos)
  map.addLayer({
    id: 'hr-label', type: 'symbol', source: 'hr',
    minzoom: 9,
    layout: {
      'text-field': ['get', 'name'],
      'text-font': ['Noto Sans Bold'],
      'text-size': ['interpolate', ['linear'], ['zoom'], 9, 10, 13, 14, 16, 18],
      'text-allow-overlap': false,
    },
    paint: {
      'text-color': dark ? '#f8fafc' : '#0a0e14',
      'text-halo-color': dark ? 'rgba(10,14,20,0.95)' : 'rgba(255,255,255,0.95)',
      'text-halo-width': 2,
      'text-halo-blur': 0.5
    }
  });

  // DGU-authoritative županije borders. Derived from JLS-union, so they
  // align pixel-perfect with our JLS polygons (topology-preserving simplify).
  map.addSource('hr-zup', { type: 'geojson', data: zupData });
  map.addLayer({
    id: 'hr-zup-line', type: 'line', source: 'hr-zup',
    layout: { visibility: showZupBorders ? 'visible' : 'none' },
    paint: {
      'line-color': dark ? '#f8fafc' : '#0a0e14',
      'line-width': ['interpolate', ['linear'], ['zoom'], 6, 1.2, 10, 2.4, 14, 4],
      'line-opacity': 0.9,
      'line-dasharray': [3, 2]
    }
  });

  // DGU-authoritative state border (Republika Hrvatska). Derived from the
  // union of all JLS, so it's the same coastline and same land border that
  // bounds every JLS polygon. Replaces (visually) the OSM border line which
  // is hidden by hideBasemapAdminLayers().
  map.addSource('hr-drz', { type: 'geojson', data: drzData });
  map.addLayer({
    id: 'hr-drz-line', type: 'line', source: 'hr-drz',
    paint: {
      'line-color': dark ? '#ffd166' : '#7a3b00',
      'line-width': ['interpolate', ['linear'], ['zoom'], 5, 1.5, 9, 2.5, 14, 4],
      'line-opacity': 0.95
    }
  });
}

// Naselja layers — only added once `naseljaLoaded` is true. Render fill +
// thin line + name labels at higher zoom only (6759 features at low zoom = chaos).
function addNaseljaLayers() {
  if (!naseljaLoaded || map.getSource('hr-nas')) return;
  map.addSource('hr-nas', { type: 'geojson', data: window._naseljaData });
  // Add naselja layers ABOVE the JLS fill so they receive clicks and the
  // distinct per-naselje colour is visible. nas_color comes from the build
  // script (deterministic palette hash of maticni_broj).
  map.addLayer({
    id: 'hr-nas-fill', type: 'fill', source: 'hr-nas',
    minzoom: 9,
    paint: {
      'fill-color': ['coalesce', ['get', 'nas_color'], ['get', 'color']],
      'fill-opacity': [
        'case',
        ['boolean', ['feature-state', 'selected'], false], 0.85,
        ['boolean', ['feature-state', 'hover'], false], 0.7,
        0.45
      ],
    }
  });
  map.addLayer({
    id: 'hr-nas-line', type: 'line', source: 'hr-nas',
    minzoom: 9,
    paint: {
      'line-color': ['case',
        ['boolean', ['feature-state', 'selected'], false], '#ffffff',
        dark ? 'rgba(255,255,255,0.65)' : 'rgba(0,0,0,0.65)'
      ],
      'line-width': ['case',
        ['boolean', ['feature-state', 'selected'], false], 3,
        ['interpolate', ['linear'], ['zoom'], 9, 0.5, 14, 1.4]
      ],
      'line-opacity': 0.95,
    }
  });
  map.addLayer({
    id: 'hr-nas-label', type: 'symbol', source: 'hr-nas',
    minzoom: 11,
    layout: {
      'text-field': ['get', 'name'],
      'text-font': ['Noto Sans Regular'],
      'text-size': ['interpolate', ['linear'], ['zoom'], 11, 9, 14, 12, 16, 16],
      'text-allow-overlap': false,
    },
    paint: {
      'text-color': dark ? '#cbd5e1' : '#1e293b',
      'text-halo-color': dark ? 'rgba(10,14,20,0.95)' : 'rgba(255,255,255,0.95)',
      'text-halo-width': 1.5,
    }
  });
  // Hover state on naselja
  let hoveredNas = null;
  map.on('mousemove', 'hr-nas-fill', e => {
    if (!e.features.length) return;
    if (hoveredNas !== null) map.setFeatureState({source:'hr-nas', id:hoveredNas}, {hover:false});
    hoveredNas = e.features[0].id;
    map.setFeatureState({source:'hr-nas', id:hoveredNas}, {hover:true});
    map.getCanvas().style.cursor = 'pointer';
  });
  map.on('mouseleave', 'hr-nas-fill', () => {
    if (hoveredNas !== null) map.setFeatureState({source:'hr-nas', id:hoveredNas}, {hover:false});
    hoveredNas = null;
    map.getCanvas().style.cursor = '';
  });
  map.on('click', 'hr-nas-fill', e => {
    if (!e.features.length) return;
    const f = e.features[0];
    const p = f.properties;
    // Mark this naselje as visually selected (white outline, brighter fill)
    if (window._selectedNaselje !== null && window._selectedNaselje !== undefined) {
      map.setFeatureState({source:'hr-nas', id: window._selectedNaselje}, {selected: false});
    }
    window._selectedNaselje = f.id;
    map.setFeatureState({source:'hr-nas', id: f.id}, {selected: true});

    document.getElementById('detail').className = 'detail-panel';
    document.getElementById('detail').innerHTML = `
      <div class="detail-name" style="border-left:3px solid ${p.color}; padding-left:10px;">${p.name}</div>
      <div class="detail-code">Naselje · ${p.jls_type || 'JLS'} ${p.jls_name || ''}</div>
      ${p.stanovnistvo ? `<div class="detail-row"><span class="k">Stanovništvo</span><span class="v">${Number(p.stanovnistvo).toLocaleString('hr')}</span></div>` : ''}
      <div class="detail-row"><span class="k">JLS</span><span class="v">${p.jls_type||''} ${p.jls_name||''}</span></div>
      <div class="detail-row"><span class="k">Županija</span><span class="v">${p.zupanija||''}</span></div>
      <div class="detail-row"><span class="k">Površina</span><span class="v">${Number(p.area_km2).toFixed(2)} km²</span></div>
      <div class="detail-row"><span class="k">Matični broj</span><span class="v">${p.maticni_broj}</span></div>
      <div class="detail-row"><span class="k">INSPIRE ID</span><span class="v" style="font-size:9px;">${p.inspire_id}</span></div>
      <div class="detail-row"><span class="k">Izvor</span><span class="v" style="font-size:10px;color:var(--muted);">DGU rpj:naselje</span></div>
    `;
  });
}

function setNaseljaVisibility(show) {
  for (const id of ['hr-nas-fill', 'hr-nas-line', 'hr-nas-label']) {
    if (map.getLayer(id)) map.setLayoutProperty(id, 'visibility', show ? 'visible' : 'none');
  }
}

async function ensureNaseljaLoaded() {
  if (naseljaLoaded || naseljaLoading) return;
  naseljaLoading = true;
  const btn = document.getElementById('btn-naselja');
  const orig = btn.firstChild.textContent;
  btn.firstChild.textContent = '⏳ Učitavam naselja… ';
  try {
    const r = await fetch('hrvatska_naselja.geojson');
    if (!r.ok) throw new Error('HTTP ' + r.status);
    window._naseljaData = await r.json();
    naseljaLoaded = true;
    addNaseljaLayers();
    // NB: applyFocusFilter is defined inside the map 'load' closure, so we
    // can't reach it from here. The caller (setNaseljaOn) re-applies the
    // filter after awaiting ensureNaseljaLoaded.
    btn.firstChild.textContent = `⊟ Naselja (${window._naseljaData.features.length}) `;
  } catch (e) {
    btn.firstChild.textContent = '❌ Naselja (fetch failed) ';
    console.error('Naselja fetch failed:', e);
  } finally {
    naseljaLoading = false;
  }
}

// Football clubs overlay — lazy-loaded GeoJSON of Point features, one per
// club with lat/lng. Color + radius scale by `top_tier` (1 = elite, 8 = amateur).
let showClubs = false;
let clubsLoaded = false;
let clubsLoading = false;
let clubsPopup = null;

const TIER_COLOR = ['match', ['get', 'top_tier'],
  1, '#d4322f', 2, '#e8853c', 3, '#e2b94f', 4, '#a8c256',
  5, '#5fa8a8', 6, '#5b8aaa', 7, '#7e7eb8', 8, '#8d99ae',
  '#8d99ae'];

function addClubsLayers() {
  if (!clubsLoaded || map.getSource('hr-clubs')) return;
  map.addSource('hr-clubs', { type: 'geojson', data: window._clubsData });
  map.addLayer({
    id: 'hr-clubs-circle', type: 'circle', source: 'hr-clubs',
    layout: { visibility: showClubs ? 'visible' : 'none' },
    paint: {
      'circle-color': TIER_COLOR,
      // Radius scales with both tier (lower tier = bigger) and zoom.
      'circle-radius': [
        'interpolate', ['linear'], ['zoom'],
        5,  ['interpolate', ['linear'], ['coalesce', ['get', 'top_tier'], 8], 1, 5, 8, 2],
        8,  ['interpolate', ['linear'], ['coalesce', ['get', 'top_tier'], 8], 1, 8, 8, 3.5],
        12, ['interpolate', ['linear'], ['coalesce', ['get', 'top_tier'], 8], 1, 14, 8, 6]
      ],
      'circle-stroke-color': '#ffffff',
      'circle-stroke-width': ['case', ['boolean', ['feature-state', 'hover'], false], 2.2, 1.2],
      'circle-opacity': 0.92,
      'circle-stroke-opacity': 0.95
    }
  });

  let hoveredClub = null;
  map.on('mousemove', 'hr-clubs-circle', e => {
    if (!e.features.length) return;
    if (hoveredClub !== null) map.setFeatureState({source:'hr-clubs', id:hoveredClub}, {hover:false});
    hoveredClub = e.features[0].id ?? e.features[0].properties.id;
    map.setFeatureState({source:'hr-clubs', id:hoveredClub}, {hover:true});
    map.getCanvas().style.cursor = 'pointer';
  });
  map.on('mouseleave', 'hr-clubs-circle', () => {
    if (hoveredClub !== null) map.setFeatureState({source:'hr-clubs', id:hoveredClub}, {hover:false});
    hoveredClub = null;
    map.getCanvas().style.cursor = '';
  });

  map.on('click', 'hr-clubs-circle', e => {
    if (!e.features.length) return;
    const f = e.features[0];
    const p = f.properties;
    const coords = f.geometry.coordinates.slice();
    if (clubsPopup) clubsPopup.remove();
    const links = [];
    if (p.website) links.push(`<a href="${p.website}" target="_blank" rel="noopener">web</a>`);
    if (p.email)   links.push(`<a href="mailto:${p.email}">email</a>`);
    if (p.phone)   links.push(`<a href="tel:${p.phone}">tel</a>`);
    if (p.fb_url)  links.push(`<a href="${p.fb_url}" target="_blank" rel="noopener">FB</a>`);
    if (p.ig_url)  links.push(`<a href="${p.ig_url}" target="_blank" rel="noopener">IG</a>`);
    if (p.x_url)   links.push(`<a href="${p.x_url}" target="_blank" rel="noopener">X</a>`);
    const tierColor = (() => {
      const c = {1:'#d4322f',2:'#e8853c',3:'#e2b94f',4:'#a8c256',
                 5:'#5fa8a8',6:'#5b8aaa',7:'#7e7eb8',8:'#8d99ae'};
      return c[p.top_tier] || '#8d99ae';
    })();
    const html = `
      <div class="club-popup">
        <div class="club-head">
          <img class="club-logo" src="logos/${p.slug}.png" onerror="this.style.display='none'" alt="">
          <div class="club-title">
            <div class="club-name">${p.canonical_name}</div>
            ${p.top_league_name ? `<div class="club-league" style="border-left:3px solid ${tierColor};padding-left:6px;">${p.top_league_name}${p.top_tier?` · tier ${p.top_tier}`:''}</div>` : ''}
          </div>
        </div>
        ${p.city || p.county ? `<div class="club-row"><span class="k">Lokacija</span><span class="v">${[p.city, p.county].filter(Boolean).join(', ')}</span></div>` : ''}
        ${p.stadium_name ? `<div class="club-row"><span class="k">Stadion</span><span class="v">${p.stadium_name}${p.stadium_capacity?` (${Number(p.stadium_capacity).toLocaleString('hr')})`:''}</span></div>` : ''}
        ${p.founded_year ? `<div class="club-row"><span class="k">Osnovan</span><span class="v">${p.founded_year}</span></div>` : ''}
        ${p.president ? `<div class="club-row"><span class="k">Predsjednik</span><span class="v">${p.president}</span></div>` : ''}
        ${p.address ? `<div class="club-row"><span class="k">Adresa</span><span class="v">${p.address}</span></div>` : ''}
        ${links.length ? `<div class="club-links">${links.join(' · ')}</div>` : ''}
        <button class="club-details-btn" data-club-id="${p.id}">Sve detalje →</button>
      </div>`;
    clubsPopup = new maplibregl.Popup({offset: 12, maxWidth: '320px', className: 'club-popup-wrap'})
      .setLngLat(coords).setHTML(html).addTo(map);
    // Wire the "Sve detalje" button — popup HTML is rendered after addTo so
    // we attach the listener now (querying the popup's DOM). We pass the
    // ORIGINAL feature from window._clubsData (not e.features[0].properties)
    // because MapLibre serializes nested arrays/objects to JSON strings and
    // would lose the structured seasons / aliases / source_ids fields.
    const popupEl = clubsPopup.getElement();
    const detailsBtn = popupEl && popupEl.querySelector('.club-details-btn');
    if (detailsBtn) detailsBtn.addEventListener('click', () => {
      const orig = window._clubsData && window._clubsData.features.find(
        x => (x.id ?? x.properties.id) === (f.id ?? p.id));
      const props = orig ? orig.properties : p;
      const [lng, lat] = (orig ? orig.geometry.coordinates : coords);
      openClubModal({...props, _lat: lat, _lng: lng});
    });
  });
}

// ── Rich-card modal ────────────────────────────────────────────────────────
// Maps tier (1..8) -> color used in the small chip beside league name.
const TIER_CHIP_COLOR = {
  1:'#d4322f',2:'#e8853c',3:'#e2b94f',4:'#a8c256',
  5:'#5fa8a8',6:'#5b8aaa',7:'#7e7eb8',8:'#8d99ae'
};

function _esc(s) {
  return String(s).replace(/[&<>"']/g, c =>
    ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

// Pretty-print a season string. SofaScore uses "25/26" (year). Hrnogomet uses
// opaque ids like "hrnogomet-season-998" — strip the prefix to show "#998".
function _fmtSeason(s) {
  if (!s) return '';
  const m = String(s).match(/^hrnogomet-season-(\d+)$/);
  if (m) return `#${m[1]}`;
  return s;
}

function _row(k, v) {
  if (v == null || v === '') return '';
  return `<div class="cm-row"><span class="k">${_esc(k)}</span><span class="v">${v}</span></div>`;
}

function _rowText(k, v) { return _row(k, v == null || v === '' ? '' : _esc(v)); }

function _section(title, bodyHtml) {
  if (!bodyHtml) return '';
  return `<div class="cm-section"><h3>${_esc(title)}</h3>${bodyHtml}</div>`;
}

function openClubModal(p) {
  const modal = document.getElementById('club-modal');
  const backdrop = document.getElementById('club-modal-backdrop');

  // ── Header ───────────────────────────────────────────────────────────────
  const shortDiff = p.short_name && p.short_name !== p.canonical_name ? p.short_name : null;
  const headHtml = `
    <div class="cm-head">
      <img class="cm-logo" src="logos/${_esc(p.slug)}.png" onerror="this.style.display='none'" alt="">
      <div class="cm-title">
        <div class="cm-name">${_esc(p.canonical_name)}</div>
        ${shortDiff ? `<div class="cm-short">${_esc(shortDiff)} · ${_esc(p.slug)}</div>` : `<div class="cm-short">${_esc(p.slug)}</div>`}
      </div>
      <button class="cm-close" id="cm-close" aria-label="Zatvori">✕</button>
    </div>`;

  // ── Sezone (grouped by league) ──────────────────────────────────────────
  let seasonsHtml = '';
  if (p.seasons && p.seasons.length) {
    const byLeague = new Map();
    for (const s of p.seasons) {
      const key = `${s.tier ?? 99}|${s.league || ''}`;
      if (!byLeague.has(key)) byLeague.set(key, { league: s.league, tier: s.tier, county: s.league_county, seasons: [] });
      byLeague.get(key).seasons.push(s);
    }
    const blocks = [...byLeague.values()]
      .sort((a, b) => (a.tier ?? 99) - (b.tier ?? 99))
      .map(g => {
        const chipColor = TIER_CHIP_COLOR[g.tier] || '#8d99ae';
        const tierChip = g.tier ? `<span class="cm-tier-chip" style="background:${chipColor}">T${g.tier}</span>` : '';
        const countyTag = g.county ? `<span class="cm-tag">${_esc(g.county)}</span>` : '';
        const pills = g.seasons.map(s => {
          const lbl = _fmtSeason(s.season) || '—';
          const src = s.source ? ` <span class="cm-tag">${_esc(s.source)}</span>` : '';
          return `<span class="cm-season-pill">${_esc(lbl)}${src}</span>`;
        }).join('');
        return `<div class="cm-league-block">
          <div class="cm-league-name">${tierChip} ${_esc(g.league || '—')}${countyTag}</div>
          <div>${pills}</div>
        </div>`;
      }).join('');
    seasonsHtml = blocks;
  }

  // ── Lokacija ────────────────────────────────────────────────────────────
  const lat = p.lat, lng = p.lng;  // properties on the original feature won't have lat/lng (stripped) — we'll set them in caller
  let lokacijaRows = '';
  lokacijaRows += _rowText('Grad', p.city);
  lokacijaRows += _rowText('Županija', p.county);
  lokacijaRows += _rowText('Adresa', p.address);
  if (p._lng != null && p._lat != null) {
    const mapsUrl = `https://www.openstreetmap.org/?mlat=${p._lat}&mlon=${p._lng}#map=16/${p._lat}/${p._lng}`;
    lokacijaRows += _row('Koordinate',
      `<a href="${mapsUrl}" target="_blank" rel="noopener">${p._lat.toFixed(5)}, ${p._lng.toFixed(5)}</a>`);
  }

  // ── Stadion / Klub ───────────────────────────────────────────────────────
  let stadionRows = '';
  stadionRows += _rowText('Stadion', p.stadium_name);
  if (p.stadium_capacity) stadionRows += _row('Kapacitet', Number(p.stadium_capacity).toLocaleString('hr'));
  if (p.founded_year) stadionRows += _row('Osnovan', _esc(p.founded_year));

  // ── Kontakt ──────────────────────────────────────────────────────────────
  let kontaktRows = '';
  if (p.website) kontaktRows += _row('Web', `<a href="${_esc(p.website)}" target="_blank" rel="noopener">${_esc(p.website)}</a>`);
  if (p.email)   kontaktRows += _row('Email', `<a href="mailto:${_esc(p.email)}">${_esc(p.email)}</a>`);
  if (p.phone) {
    const kindTag = p.phone_kind ? `<span class="cm-tag">${_esc(p.phone_kind)}</span>` : '';
    const tel = p.phone_e164 || p.phone;
    kontaktRows += _row('Telefon', `<a href="tel:${_esc(tel)}">${_esc(p.phone)}</a>${kindTag}`);
  }
  if (p.president) kontaktRows += _rowText('Predsjednik', p.president);

  // ── Društvene mreže ─────────────────────────────────────────────────────
  const socials = [];
  if (p.fb_url) socials.push(`<a href="${_esc(p.fb_url)}" target="_blank" rel="noopener">Facebook</a>`);
  if (p.ig_url) socials.push(`<a href="${_esc(p.ig_url)}" target="_blank" rel="noopener">Instagram</a>`);
  if (p.x_url)  socials.push(`<a href="${_esc(p.x_url)}" target="_blank" rel="noopener">X / Twitter</a>`);
  const socialsHtml = socials.length ? `<div class="cm-socials">${socials.join('')}</div>` : '';

  // ── Aliasi ──────────────────────────────────────────────────────────────
  let aliasesHtml = '';
  if (p.aliases && p.aliases.length) {
    aliasesHtml = `<div class="cm-aliases-list">` + p.aliases.map(a =>
      `<span class="cm-season-pill">${_esc(a.alias)}<span class="cm-tag">${_esc(a.source)}</span></span>`
    ).join('') + `</div>`;
  }

  // ── Vanjski izvori (sofascore-id, hrnogomet-id) ─────────────────────────
  let sourceIdsHtml = '';
  if (p.source_ids && p.source_ids.length) {
    sourceIdsHtml = p.source_ids.map(s => {
      let linked = _esc(s.id);
      if (s.source === 'sofascore-id') linked = `<a href="https://www.sofascore.com/team/football/x/${_esc(s.id)}" target="_blank" rel="noopener">${_esc(s.id)}</a>`;
      return _row(s.source, linked);
    }).join('');
  }

  // ── Meta ────────────────────────────────────────────────────────────────
  let metaRows = '';
  if (p.notes) metaRows += _rowText('Bilješke', p.notes);
  if (p.created_at) metaRows += _rowText('Dodano', p.created_at);
  if (p.updated_at) metaRows += _rowText('Ažurirano', p.updated_at);

  modal.innerHTML = headHtml
    + _section('Sezone / lige', seasonsHtml)
    + _section('Lokacija', lokacijaRows)
    + _section('Stadion', stadionRows)
    + _section('Kontakt', kontaktRows)
    + _section('Društvene mreže', socialsHtml)
    + _section('Aliasi', aliasesHtml)
    + _section('Vanjski izvori', sourceIdsHtml)
    + _section('Meta', metaRows);

  backdrop.classList.add('open');
  backdrop.setAttribute('aria-hidden', 'false');
  const closeBtn = document.getElementById('cm-close');
  if (closeBtn) closeBtn.addEventListener('click', closeClubModal);
}

function closeClubModal() {
  const backdrop = document.getElementById('club-modal-backdrop');
  backdrop.classList.remove('open');
  backdrop.setAttribute('aria-hidden', 'true');
}

function setClubsVisibility(show) {
  if (map.getLayer('hr-clubs-circle')) {
    map.setLayoutProperty('hr-clubs-circle', 'visibility', show ? 'visible' : 'none');
  }
  if (!show && clubsPopup) { clubsPopup.remove(); clubsPopup = null; }
}

async function ensureClubsLoaded() {
  if (clubsLoaded || clubsLoading) return;
  clubsLoading = true;
  const btn = document.getElementById('btn-clubs');
  btn.firstChild.textContent = '⏳ Učitavam klubove… ';
  try {
    const r = await fetch('hr_football_clubs.geojson');
    if (!r.ok) throw new Error('HTTP ' + r.status);
    const fc = await r.json();
    // Promote properties.id to top-level Feature.id so setFeatureState works.
    fc.features.forEach(f => { if (f.id == null && f.properties && f.properties.id != null) f.id = f.properties.id; });
    window._clubsData = fc;
    clubsLoaded = true;
    addClubsLayers();
    btn.firstChild.textContent = `⚽ Klubovi (${fc.features.length}) `;
  } catch (e) {
    btn.firstChild.textContent = '❌ Klubovi (fetch failed) ';
    console.error('Clubs fetch failed:', e);
  } finally {
    clubsLoading = false;
  }
}

// OSM/OpenFreeMap basemap renders its own admin/state lines, which don't
// align with DGU. Hide them so only the authoritative DGU lines we draw on
// top are visible.
function hideBasemapAdminLayers() {
  const style = map.getStyle();
  if (!style || !style.layers) return;
  const adminPattern = /admin|boundary|country|border/i;
  for (const l of style.layers) {
    if (adminPattern.test(l.id) || (l['source-layer'] && adminPattern.test(l['source-layer']))) {
      try { map.setLayoutProperty(l.id, 'visibility', 'none'); } catch (e) {}
    }
  }
}

map.on('load', () => {
  hideBasemapAdminLayers();
  addJlsLayers();

  // Fit Croatia (HR bbox approx)
  map.fitBounds([[13.4, 42.3], [19.5, 46.6]], { padding: 25, duration: 0 });

  // Live zoom + ground-resolution readout (Web Mercator: 156543·cos(lat)/2^z m/px).
  const zVal = document.getElementById('zoom-val');
  const zMpp = document.getElementById('zoom-mpp');
  const refreshZoom = () => {
    const z = map.getZoom();
    const lat = map.getCenter().lat;
    const mpp = 156543.03392 * Math.cos(lat * Math.PI / 180) / Math.pow(2, z);
    zVal.textContent = z.toFixed(2);
    zMpp.textContent = mpp >= 1000 ? (mpp / 1000).toFixed(1) + ' km' : mpp.toFixed(1);
  };
  refreshZoom();
  map.on('move', refreshZoom);
  map.on('zoom', refreshZoom);

  // Hover breadcrumb: županija › JLS › naselje (naselje only when its layer is on).
  const hovBox = document.getElementById('hover-info');
  const hovZup = document.getElementById('hov-zup');
  const hovJls = document.getElementById('hov-jls');
  const hovNas = document.getElementById('hov-nas');
  const hovNasSeg = document.getElementById('hov-nas-seg');
  const hovSep2 = document.getElementById('hov-sep2');
  map.on('mousemove', e => {
    const layers = [];
    if (map.getLayer('hr-fill')) layers.push('hr-fill');
    if (showNaselja && naseljaLoaded && map.getLayer('hr-nas-fill')) layers.push('hr-nas-fill');
    if (!layers.length) { hovBox.classList.remove('visible'); return; }
    const feats = map.queryRenderedFeatures(e.point, { layers });
    const jls = feats.find(f => f.layer.id === 'hr-fill');
    const nas = feats.find(f => f.layer.id === 'hr-nas-fill');
    if (!jls && !nas) { hovBox.classList.remove('visible'); return; }
    // Naselje carries jls + zupanija context; prefer it when present.
    const src = nas ? nas.properties : jls.properties;
    hovZup.textContent = src.zupanija || '—';
    const jlsLabel = nas
      ? `${src.jls_type || ''} ${src.jls_name || ''}`.trim()
      : `${src.type || ''} ${src.name || ''}`.trim();
    hovJls.textContent = jlsLabel || '—';
    if (nas) {
      hovNas.textContent = nas.properties.name || '—';
      hovNasSeg.style.display = '';
      hovSep2.style.display = '';
    } else {
      hovNasSeg.style.display = 'none';
      hovSep2.style.display = 'none';
    }
    hovBox.classList.add('visible');
  });
  map.on('mouseleave', () => hovBox.classList.remove('visible'));
  map.getContainer().addEventListener('mouseleave', () => hovBox.classList.remove('visible'));

  // Hide loading screen
  document.getElementById('loading').classList.add('gone');

  // Hover state
  let hovered = null;
  map.on('mousemove', 'hr-fill', e => {
    if (!e.features.length) return;
    if (hovered !== null) map.setFeatureState({source:'hr', id:hovered}, {hover:false});
    hovered = e.features[0].id;
    map.setFeatureState({source:'hr', id:hovered}, {hover:true});
    map.getCanvas().style.cursor = 'pointer';
  });
  map.on('mouseleave', 'hr-fill', () => {
    if (hovered !== null) map.setFeatureState({source:'hr', id:hovered}, {hover:false});
    hovered = null;
    map.getCanvas().style.cursor = '';
  });

  // Click → select. JLS clicks are suppressed only when a naselje is actually
  // rendered under the click point — i.e. naselja layer is on AND the user is
  // zoomed in past the naselja minzoom AND there is a naselje feature beneath
  // the cursor. At lower zooms (or over sea / gaps) clicking JLS still works.
  let selected = null;
  map.on('click', 'hr-fill', e => {
    if (!e.features.length) return;
    if (showNaselja && naseljaLoaded && map.getLayer('hr-nas-fill')) {
      const nasUnder = map.queryRenderedFeatures(e.point, { layers: ['hr-nas-fill'] });
      if (nasUnder.length) return;  // naselje handler fires instead
    }
    selectJLS(e.features[0].id);
  });

  function selectJLS(id) {
    if (selected !== null) map.setFeatureState({source:'hr', id:selected}, {selected:false});
    selected = id;
    map.setFeatureState({source:'hr', id}, {selected:true});

    const f = data.features.find(x => x.id === id);
    const p = f.properties;

    document.getElementById('detail').className = 'detail-panel';
    document.getElementById('detail').innerHTML = `
      <div class="detail-name" style="border-left:3px solid ${p.color}; padding-left:10px;">${p.name}</div>
      <div class="detail-code">${p.name_full || p.shapeName || (p.type + ' ' + p.name)}</div>
      <div class="detail-row"><span class="k">Tip</span><span class="v">${p.type}</span></div>
      <div class="detail-row"><span class="k">Županija</span><span class="v">${p.zupanija}</span></div>
      ${p.roa ? `<div class="detail-row"><span class="k">Sjedište</span><span class="v">${p.roa}</span></div>` : ''}
      ${p.maticni_broj ? `<div class="detail-row"><span class="k">Matični broj</span><span class="v">${p.maticni_broj}</span></div>` : ''}
      <div class="detail-row"><span class="k">Površina</span><span class="v">${p.area_km2.toFixed(2)} km²</span></div>
      <div class="detail-row"><span class="k">U m²</span><span class="v">${p.area_m2.toLocaleString('hr')}</span></div>
      <div class="detail-row"><span class="k">Udio HR</span><span class="v">${(p.area_m2 / totalArea * 100).toFixed(3)} %</span></div>
      ${p.inspire_id ? `<div class="detail-row"><span class="k">INSPIRE ID</span><span class="v" style="font-size:9px;">${p.inspire_id}</span></div>` : ''}
      ${p.source ? `<div class="detail-row"><span class="k">Izvor</span><span class="v" style="font-size:10px;color:var(--muted);">${p.source}</span></div>` : ''}
    `;
    // Smooth fly to feature bounds
    const b = computeBounds(f.geometry);
    map.fitBounds(b, { padding: 50, maxZoom: 12, duration: 800 });
    // Drill-down: selecting a JLS auto-enables focus + naselja (lazy-loaded
    // on first activation; the focus filter is reapplied once naselja arrive).
    setFocusMode(true);
    setNaseljaOn(true);
  }

  // Županija filter
  let activeZup = null;
  document.querySelectorAll('.zup-row').forEach(row => {
    row.addEventListener('click', () => {
      const zup = row.dataset.zupanija;
      if (activeZup === zup) {
        // unfilter
        activeZup = null;
        row.classList.remove('active');
        clearDimming();
      } else {
        document.querySelectorAll('.zup-row').forEach(r => r.classList.remove('active'));
        row.classList.add('active');
        activeZup = zup;
        applyDimming(zup);
        // zoom to all features of that županija
        const fs = data.features.filter(f => f.properties.zupanija === zup);
        if (fs.length) {
          let minX=Infinity, minY=Infinity, maxX=-Infinity, maxY=-Infinity;
          fs.forEach(f => walkCoords(f.geometry, (x,y) => {
            if (x<minX) minX=x; if (x>maxX) maxX=x;
            if (y<minY) minY=y; if (y>maxY) maxY=y;
          }));
          map.fitBounds([[minX,minY],[maxX,maxY]], { padding: 40, duration: 1000 });
        }
      }
    });
  });

  function applyDimming(zupName) {
    data.features.forEach(f => {
      const dim = f.properties.zupanija !== zupName;
      map.setFeatureState({source:'hr', id:f.id}, {dimmed: dim});
    });
  }
  function clearDimming() {
    data.features.forEach(f => map.setFeatureState({source:'hr', id:f.id}, {dimmed:false}));
  }

  // Pick a naselje from a search result: drill-down to its parent JLS
  // (loading naselja if needed), then highlight the naselje and zoom to it.
  async function selectNaseljeFromSearch(nasFeat) {
    const mb = nasFeat.properties.jls_maticni_broj;
    const parentJls = data.features.find(f => f.properties.maticni_broj === mb);
    if (parentJls) {
      selectJLS(parentJls.id);  // sets focus + triggers naselja load
    } else {
      setFocusMode(true);
      await setNaseljaOn(true);
    }
    if (!naseljaLoaded) await ensureNaseljaLoaded();
    // Clear previous naselje selection
    if (window._selectedNaselje != null && map.getSource('hr-nas')) {
      map.setFeatureState({source:'hr-nas', id: window._selectedNaselje}, {selected:false});
    }
    window._selectedNaselje = nasFeat.id;
    if (map.getSource('hr-nas')) {
      map.setFeatureState({source:'hr-nas', id: nasFeat.id}, {selected:true});
    }
    // Detail panel — naselje info (overrides the JLS info that selectJLS set)
    const p = nasFeat.properties;
    document.getElementById('detail').className = 'detail-panel';
    document.getElementById('detail').innerHTML = `
      <div class="detail-name" style="border-left:3px solid ${p.color || '#06aed5'}; padding-left:10px;">${p.name}</div>
      <div class="detail-code">Naselje · ${p.jls_type || 'JLS'} ${p.jls_name || ''}</div>
      ${p.stanovnistvo ? `<div class="detail-row"><span class="k">Stanovništvo</span><span class="v">${Number(p.stanovnistvo).toLocaleString('hr')}</span></div>` : ''}
      <div class="detail-row"><span class="k">JLS</span><span class="v">${p.jls_type||''} ${p.jls_name||''}</span></div>
      <div class="detail-row"><span class="k">Županija</span><span class="v">${p.zupanija||''}</span></div>
      <div class="detail-row"><span class="k">Površina</span><span class="v">${Number(p.area_km2).toFixed(2)} km²</span></div>
      <div class="detail-row"><span class="k">Matični broj</span><span class="v">${p.maticni_broj}</span></div>
    `;
    // Zoom to naselje
    const b = computeBounds(nasFeat.geometry);
    map.fitBounds(b, { padding: 60, maxZoom: 14, duration: 800 });
  }

  // Search box — across JLS and (lazy-loaded) naselja.
  const searchInput = document.getElementById('search');
  const searchResults = document.getElementById('search-results');
  let searchKickedNaseljaLoad = false;

  function renderSearch(q) {
    if (q.length < 2) { searchResults.style.display = 'none'; return; }
    const jlsMatches = data.features
      .filter(f => f.properties.name.toLowerCase().includes(q))
      .slice(0, 15);
    let nasMatches = [];
    if (naseljaLoaded && window._naseljaData) {
      nasMatches = window._naseljaData.features
        .filter(f => f.properties.name && f.properties.name.toLowerCase().includes(q))
        .slice(0, 30);
    }
    let html = '';
    for (const f of jlsMatches) {
      const cls = f.properties.type === 'Grad' ? 'grad' : 'opc';
      html += `<div class="jls-result-row" data-kind="jls" data-id="${f.id}">
        <div><span class="badge-kind ${cls}">${f.properties.type}</span><span class="jls-result-name">${f.properties.name}</span></div>
        <div class="jls-result-zup">${f.properties.zupanija}</div>
      </div>`;
    }
    for (const f of nasMatches) {
      const p = f.properties;
      const pop = p.stanovnistvo ? Number(p.stanovnistvo).toLocaleString('hr') : '';
      html += `<div class="jls-result-row" data-kind="nas" data-id="${f.id}">
        <div><span class="badge-kind nas">naselje</span><span class="jls-result-name">${p.name}</span>${pop ? `<span class="pop-meta"> · ${pop}</span>` : ''}</div>
        <div class="jls-result-zup">${p.jls_type || ''} ${p.jls_name || ''} · ${p.zupanija || ''}</div>
      </div>`;
    }
    if (!naseljaLoaded) {
      html += `<div class="jls-result-loading">${naseljaLoading ? 'Učitavam naselja…' : 'Naselja se učitavaju u pozadini za potpunu pretragu'}</div>`;
      if (!naseljaLoading && !searchKickedNaseljaLoad) {
        searchKickedNaseljaLoad = true;
        ensureNaseljaLoaded().then(() => renderSearch(searchInput.value.trim().toLowerCase()));
      }
    }
    searchResults.innerHTML = html;
    searchResults.style.display = html ? 'block' : 'none';
    searchResults.querySelectorAll('.jls-result-row').forEach(row => {
      row.addEventListener('click', () => {
        const id = parseInt(row.dataset.id);
        const kind = row.dataset.kind;
        if (kind === 'jls') {
          selectJLS(id);
        } else if (kind === 'nas' && window._naseljaData) {
          const nasFeat = window._naseljaData.features.find(f => f.id === id);
          if (nasFeat) selectNaseljeFromSearch(nasFeat);
        }
        searchResults.style.display = 'none';
        searchInput.value = '';
      });
    });
  }
  searchInput.addEventListener('input', e => renderSearch(e.target.value.trim().toLowerCase()));

  // Color mode toggle
  const colorBtn = document.getElementById('btn-zup-mode');
  colorBtn.addEventListener('click', () => {
    colorMode = colorMode === 'zupanija' ? 'type' : 'zupanija';
    if (colorMode === 'type') {
      map.setPaintProperty('hr-fill', 'fill-color', [
        'match', ['get', 'type'],
        'Grad', '#d4322f',
        'Općina', '#588b8b',
        'Otok', '#06aed5',
        '#8d99ae'
      ]);
      map.setPaintProperty('hr-line', 'line-color', [
        'match', ['get', 'type'],
        'Grad', '#d4322f', 'Općina', '#588b8b', 'Otok', '#06aed5', '#8d99ae'
      ]);
      colorBtn.firstChild.textContent = '🎨 Color: tip ';
    } else {
      map.setPaintProperty('hr-fill', 'fill-color', ['get', 'color']);
      map.setPaintProperty('hr-line', 'line-color', [
        'case', ['boolean', ['feature-state', 'selected'], false], '#ffffff',
        ['get', 'color']
      ]);
      colorBtn.firstChild.textContent = '🎨 Color: županija ';
    }
  });

  document.getElementById('btn-fit').addEventListener('click', () => {
    map.fitBounds([[13.4, 42.3], [19.5, 46.6]], { padding: 25, duration: 1000 });
    // Reset drill-down state: clear selection, leave focus + naselja off.
    if (selected !== null) {
      map.setFeatureState({source:'hr', id:selected}, {selected:false});
      selected = null;
    }
    if (window._selectedNaselje != null && map.getSource('hr-nas')) {
      map.setFeatureState({source:'hr-nas', id: window._selectedNaselje}, {selected:false});
    }
    window._selectedNaselje = null;
    setFocusMode(false);
    setNaseljaOn(false);
    document.getElementById('detail').className = 'detail-panel empty';
    document.getElementById('detail').innerHTML = 'Klikni JLS na karti<br>ili pretraži ime gore lijevo';
    document.querySelectorAll('.zup-row.active').forEach(r => r.classList.remove('active'));
    activeZup = null;
    clearDimming();
  });

  document.getElementById('btn-legend').addEventListener('click', () => {
    const panel = document.getElementById('legend');
    const open = panel.classList.toggle('open');
    document.getElementById('btn-legend').classList.toggle('active', open);
  });

  document.getElementById('btn-fineprint').addEventListener('click', () => {
    const panel = document.getElementById('fineprint');
    const open = panel.classList.toggle('open');
    document.getElementById('btn-fineprint').classList.toggle('active', open);
  });

  document.getElementById('btn-zup-borders').addEventListener('click', () => {
    showZupBorders = !showZupBorders;
    if (map.getLayer('hr-zup-line')) {
      map.setLayoutProperty('hr-zup-line', 'visibility', showZupBorders ? 'visible' : 'none');
    }
    document.getElementById('btn-zup-borders').classList.toggle('active', showZupBorders);
  });

  document.getElementById('btn-jls-borders').addEventListener('click', () => {
    showJlsBorders = !showJlsBorders;
    if (map.getLayer('hr-line')) {
      map.setLayoutProperty('hr-line', 'visibility', showJlsBorders ? 'visible' : 'none');
    }
    document.getElementById('btn-jls-borders').classList.toggle('active', showJlsBorders);
  });

  function setFocusMode(on) {
    focusMode = !!on;
    document.getElementById('btn-focus').classList.toggle('active', focusMode);
    applyFocusFilter();
  }
  document.getElementById('btn-focus').addEventListener('click', () => setFocusMode(!focusMode));

  // Focus filter: when active + a JLS is selected, hide every other JLS and
  // every naselje not in that JLS — except hr-fill stays queryable so the
  // user can still click on neighbouring JLS to switch focus. We use:
  //   - feature-state focus_hidden (paint opacity 0) on hr-fill
  //   - setFilter on hr-line / hr-label (visible borders + labels gone)
  //   - setFilter on hr-nas-* (only selected JLS' naselja render)
  function applyFocusFilter() {
    const filterLayers = ['hr-line', 'hr-label', 'hr-nas-fill', 'hr-nas-line', 'hr-nas-label'];
    if (!focusMode || selected === null) {
      // Clear focus_hidden state on all JLS + clear setFilter on filter layers
      for (const f of data.features) {
        map.setFeatureState({source: 'hr', id: f.id}, {focus_hidden: false});
      }
      for (const id of filterLayers) if (map.getLayer(id)) map.setFilter(id, null);
      return;
    }
    const sel = data.features.find(f => f.id === selected);
    if (!sel) return;
    const mb = sel.properties.maticni_broj;
    // Mark every non-selected JLS as focus_hidden — paint becomes opacity 0,
    // but the layer stays interactive so clicks switch the focus.
    for (const f of data.features) {
      map.setFeatureState({source: 'hr', id: f.id}, {focus_hidden: f.id !== selected});
    }
    const jlsFilter = ['==', ['get', 'maticni_broj'], mb];
    const nasFilter = ['==', ['get', 'jls_maticni_broj'], mb];
    if (map.getLayer('hr-line'))  map.setFilter('hr-line',  jlsFilter);
    if (map.getLayer('hr-label')) map.setFilter('hr-label', jlsFilter);
    if (map.getLayer('hr-nas-fill'))  map.setFilter('hr-nas-fill',  nasFilter);
    if (map.getLayer('hr-nas-line'))  map.setFilter('hr-nas-line',  nasFilter);
    if (map.getLayer('hr-nas-label')) map.setFilter('hr-nas-label', nasFilter);
  }

  async function setNaseljaOn(on) {
    on = !!on;
    if (showNaselja === on && (on === false || naseljaLoaded)) {
      document.getElementById('btn-naselja').classList.toggle('active', on);
      if (naseljaLoaded) setNaseljaVisibility(on);
      return;
    }
    showNaselja = on;
    document.getElementById('btn-naselja').classList.toggle('active', on);
    if (on && !naseljaLoaded) {
      await ensureNaseljaLoaded();
      // Naselja layers were created during ensureNaseljaLoaded — re-apply the
      // focus filter so they don't render outside the currently-selected JLS.
      applyFocusFilter();
    }
    setNaseljaVisibility(on);
  }
  document.getElementById('btn-naselja').addEventListener('click', () => setNaseljaOn(!showNaselja));

  async function setClubsOn(on) {
    on = !!on;
    showClubs = on;
    document.getElementById('btn-clubs').classList.toggle('active', on);
    if (on && !clubsLoaded) await ensureClubsLoaded();
    setClubsVisibility(on);
  }
  document.getElementById('btn-clubs').addEventListener('click', () => setClubsOn(!showClubs));

  document.getElementById('btn-style').addEventListener('click', () => {
    dark = !dark;
    const nextTheme = dark ? 'dark' : 'light';
    if (nextTheme === 'light') document.documentElement.setAttribute('data-theme', 'light');
    else document.documentElement.removeAttribute('data-theme');
    try { localStorage.setItem('domovina-theme', nextTheme); } catch (e) {}
    map.setStyle(dark ? STYLE_DARK : STYLE_LIGHT, { diff: false });
    map.once('style.load', () => {
      hideBasemapAdminLayers();
      addJlsLayers();
      // Restore selection / dimming feature-state after the source is re-created
      data.features.forEach(f => {
        const fs = {};
        if (selected === f.id) fs.selected = true;
        if (activeZup && f.properties.zupanija !== activeZup) fs.dimmed = true;
        if (Object.keys(fs).length) map.setFeatureState({source:'hr', id:f.id}, fs);
      });
      // Re-add naselja if they were already loaded + visible
      if (naseljaLoaded) {
        addNaseljaLayers();
        setNaseljaVisibility(showNaselja);
        if (window._selectedNaselje !== null && window._selectedNaselje !== undefined) {
          map.setFeatureState({source:'hr-nas', id: window._selectedNaselje}, {selected: true});
        }
      }
      // Re-add clubs if loaded + visible
      if (clubsLoaded) {
        addClubsLayers();
        setClubsVisibility(showClubs);
      }
      // Re-apply persistent UI states across style change
      if (map.getLayer('hr-line') && !showJlsBorders) {
        map.setLayoutProperty('hr-line', 'visibility', 'none');
      }
      applyFocusFilter();
    });
    document.getElementById('btn-style').classList.toggle('active', !dark);
  });

  // Initialize style-button active state to reflect persisted theme.
  document.getElementById('btn-style').classList.toggle('active', !dark);

  // Close rich-card modal on ESC or backdrop click. Backdrop wiring is set
  // once here (the modal HTML is static, only its inner content is replaced).
  document.getElementById('club-modal-backdrop').addEventListener('click', e => {
    if (e.target.id === 'club-modal-backdrop') closeClubModal();
  });

  document.addEventListener('keydown', e => {
    if (e.target.tagName === 'INPUT') return;
    if (e.key === 'Escape' && document.getElementById('club-modal-backdrop').classList.contains('open')) {
      closeClubModal();
      return;
    }
    if (e.key.toLowerCase() === 'c') colorBtn.click();
    if (e.key.toLowerCase() === 'l') document.getElementById('btn-style').click();
    if (e.key.toLowerCase() === 'f') document.getElementById('btn-fit').click();
    if (e.key.toLowerCase() === 'b') document.getElementById('btn-zup-borders').click();
    if (e.key.toLowerCase() === 'j') document.getElementById('btn-jls-borders').click();
    if (e.key.toLowerCase() === 'n') document.getElementById('btn-naselja').click();
    if (e.key.toLowerCase() === 'o') document.getElementById('btn-focus').click();
    if (e.key.toLowerCase() === 'k') document.getElementById('btn-clubs').click();
  });
});

function walkCoords(g, cb) {
  if (g.type === 'Point') return cb(...g.coordinates);
  if (g.type === 'Polygon') return g.coordinates.forEach(r => r.forEach(c => cb(c[0], c[1])));
  if (g.type === 'MultiPolygon') return g.coordinates.forEach(p => p.forEach(r => r.forEach(c => cb(c[0], c[1]))));
}
function computeBounds(g) {
  let minX=Infinity, minY=Infinity, maxX=-Infinity, maxY=-Infinity;
  walkCoords(g, (x,y) => {
    if (x<minX) minX=x; if (x>maxX) maxX=x;
    if (y<minY) minY=y; if (y>maxY) maxY=y;
  });
  return [[minX, minY], [maxX, maxY]];
}
</script>
</body>
</html>
