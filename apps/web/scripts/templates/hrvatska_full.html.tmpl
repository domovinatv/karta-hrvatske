<!doctype html>
<html lang="hr">
<head>
<meta charset="utf-8">
<title>DOMOVINA · Republika Hrvatska — __NJLS__ JLS</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#002F6C">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

<script>
  // Sync theme attribute before CSS paints (no FOUC). Default: dark.
  (function () {
    try {
      var t = localStorage.getItem('domovina-theme');
      if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
    } catch (e) {}
  })();
</script>
<link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet">
<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
<script src="https://unpkg.com/pmtiles@3.2.1/dist/pmtiles.js"></script>

<style>
:root {
  /* Dark theme (default) — dark UI shell, used with dark-matter basemap.
     --brand-red is pure #FF0000 for true brand elements (.ai suffix,
     tricolor stripe). --ui-accent is a muted brand-derived red used
     for UI states (active borders, hover text, badges) — keeps the
     map's brick-red Grad fills from clashing with the chrome. */
  --bg: #0a0e14; --bg-2: #11161e; --bg-3: #1a212c; --line: #232b38;
  --text: #e6edf3; --muted: #8b94a8; --accent-2: #5B8DCE;
  --good: #4ade80; --ink: #f8fafc;
  --brand-navy: #002F6C; --brand-red: #FF0000;
  --ui-accent: #EF4444;                  /* readable on dark bg */
  --ui-accent-tint: rgba(239, 68, 68, 0.12);
  --map-bg: #0a0e14;
  --overlay-strong: rgba(10, 14, 20, 0.92);
  --overlay-soft:   rgba(10, 14, 20, 0.85);
  --popup-bg:       rgba(10, 14, 20, 0.95);
  --popup-shadow:   0 8px 32px rgba(0, 0, 0, 0.6);
}
:root[data-theme="light"] {
  /* Light theme — DOMOVINA brand on a slightly off-white surface.
     Pure #FFFFFF was harsh against saturated polygon fills; #FAFBFC
     reduces eye strain and lets the map carry the saturation. */
  --bg: #FAFBFC; --bg-2: #F5F7F9; --bg-3: #EEF2F5; --line: #D1D5DB;
  --text: #002F6C; --muted: #5A6570; --accent-2: #002F6C;
  --good: #16a34a; --ink: #001a40;
  --ui-accent: #DC2626;                  /* readable on light bg */
  --ui-accent-tint: rgba(220, 38, 38, 0.08);
  --map-bg: #F5F7F9;
  --overlay-strong: rgba(255, 255, 255, 0.94);
  --overlay-soft:   rgba(255, 255, 255, 0.88);
  --popup-bg:       rgba(255, 255, 255, 0.97);
  --popup-shadow:   0 1px 3px rgba(0, 47, 108, 0.08), 0 4px 12px rgba(0, 47, 108, 0.10);
}
* { box-sizing: border-box; }
html, body { height: 100%; margin: 0; }
body {
  font-family: system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
  background: var(--bg); color: var(--text);
  font-size: 13px; line-height: 1.4;
  display: grid; grid-template-rows: auto auto 1fr;
  height: 100vh;
}

/* DOMOVINA brand tricolor stripe — red / white / navy */
.brand-stripe { display: flex; height: 4px; width: 100%; flex-shrink: 0; }
.brand-stripe span { flex: 1; }
.brand-stripe span:nth-child(1) { background: var(--brand-red); }
.brand-stripe span:nth-child(2) { background: #ffffff; }
.brand-stripe span:nth-child(3) { background: var(--brand-navy); }

header {
  background: linear-gradient(180deg, var(--bg-2) 0%, var(--bg) 100%);
  border-bottom: 1px solid var(--line);
  padding: 14px 24px;
  display: flex; align-items: center; gap: 24px; flex-wrap: wrap;
}
header h1 {
  margin: 0;
  display: inline-flex; align-items: baseline; gap: 12px;
  font-weight: 600; font-size: 20px; color: var(--ink);
}
header h1 .brand-word {
  font-family: system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
  font-weight: 800;
  letter-spacing: 0.08em;
  font-size: 22px;
  color: var(--ink);
}
header h1 .brand-word .ai { color: var(--brand-red); letter-spacing: 0; }
header h1 .context {
  font-family: 'Fraunces', Georgia, serif;
  font-weight: 600;
  letter-spacing: -0.01em;
}
header h1 .sep { color: var(--muted); font-weight: 400; }
header .subtitle {
  color: var(--muted); font-size: 11px;
  text-transform: uppercase; letter-spacing: 0.18em;
}
header .badges { margin-left: auto; display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
.badge {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 4px 10px; border: 1px solid var(--line);
  border-radius: 100px; font-size: 10.5px;
  background: var(--bg-3); color: var(--text); white-space: nowrap;
}
.badge.gpu { border-color: rgba(91, 141, 206, 0.4); color: var(--accent-2); background: rgba(91, 141, 206, 0.05); }
.badge.gpu::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--accent-2); box-shadow: 0 0 12px var(--accent-2); animation: pulse 2s infinite; }
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
.badge.free { border-color: rgba(74, 222, 128, 0.3); color: var(--good); }
.badge.zero { border-color: color-mix(in srgb, var(--ui-accent) 35%, transparent); color: var(--ui-accent); }

main {
  display: grid;
  grid-template-columns: 320px 1fr 380px;
  overflow: hidden;
}
@media (max-width: 1200px) { main { grid-template-columns: 280px 1fr; } aside.right { display: none; } }
@media (max-width: 800px) { main { grid-template-columns: 1fr; grid-template-rows: 220px 1fr; } }

aside {
  background: var(--bg-2);
  overflow-y: auto;
  border-right: 1px solid var(--line);
  scrollbar-width: thin;
  scrollbar-color: var(--line) transparent;
}
aside.right { border-right: 0; border-left: 1px solid var(--line); }
aside h2 {
  font-family: 'Fraunces', Georgia, serif;
  font-size: 13px; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.12em;
  margin: 0; padding: 16px 18px 12px;
  color: var(--muted); border-bottom: 1px solid var(--line);
  display: flex; justify-content: space-between; align-items: baseline;
}
aside h2 .meta { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0; color: var(--accent-2); text-transform: none; }

#map { background: var(--map-bg); height: 100%; }
.maplibregl-ctrl-attrib { background: var(--overlay-soft) !important; color: var(--muted) !important; }
.maplibregl-ctrl-attrib a { color: var(--text) !important; }

.statgrid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 1px; background: var(--line); border-bottom: 1px solid var(--line);
}
.stat { background: var(--bg-2); padding: 12px 14px; }
.stat-label {
  font-size: 9px; text-transform: uppercase;
  letter-spacing: 0.15em; color: var(--muted); margin-bottom: 4px;
}
.stat-value {
  font-family: 'Fraunces', Georgia, serif;
  font-size: 20px; font-weight: 600;
  letter-spacing: -0.01em; color: var(--ink);
}
.stat-unit { font-size: 11px; color: var(--muted); margin-left: 4px; font-family: 'JetBrains Mono', monospace; font-weight: normal; }

.zup-list { padding: 8px 0; }
.zup-row {
  display: grid;
  grid-template-columns: 12px 1fr auto;
  gap: 10px; align-items: center;
  padding: 7px 18px; cursor: pointer;
  border-left: 2px solid transparent;
  font-size: 11.5px;
  transition: background 0.12s, border-color 0.12s;
}
.zup-row:hover { background: var(--bg-3); }
.zup-row.active { background: var(--ui-accent-tint); border-left-color: var(--ui-accent); }
.zup-swatch { width: 12px; height: 12px; border-radius: 2px; }
.zup-name { color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.zup-meta { color: var(--muted); font-size: 10px; font-variant-numeric: tabular-nums; }

.search-box {
  padding: 12px 18px;
  border-bottom: 1px solid var(--line);
}
.search-box input {
  width: 100%;
  background: var(--bg);
  border: 1px solid var(--line);
  color: var(--text);
  font-family: inherit;
  font-size: 12px;
  padding: 8px 10px;
  border-radius: 4px;
}
.search-box input:focus { outline: none; border-color: var(--accent-2); }
.jls-results { max-height: 250px; overflow-y: auto; padding: 4px 0; }
.jls-result-row {
  padding: 6px 18px;
  cursor: pointer;
  font-size: 11px;
  display: flex;
  justify-content: space-between;
  border-left: 2px solid transparent;
}
.jls-result-row:hover { background: var(--bg-3); border-left-color: var(--accent-2); }
.jls-result-name { color: var(--text); }
.jls-result-zup { color: var(--muted); font-size: 10px; }
.jls-result-row .badge-kind {
  display: inline-block; padding: 1px 6px; margin-right: 6px;
  font-size: 8.5px; font-weight: 600; letter-spacing: 0.06em;
  border-radius: 100px; vertical-align: middle;
  border: 1px solid var(--line); color: var(--muted);
  text-transform: uppercase;
}
.jls-result-row .badge-kind.grad { color: #d4322f; border-color: rgba(212,50,47,.4); }
.jls-result-row .badge-kind.opc  { color: #588b8b; border-color: rgba(88,139,139,.4); }
.jls-result-row .badge-kind.nas  { color: var(--accent-2); border-color: rgba(91,141,206,.4); }
.jls-result-row .pop-meta { font-size: 9px; color: var(--muted); }
.jls-result-loading { padding: 8px 18px; font-size: 10px; color: var(--muted); font-style: italic; }

.detail-panel { padding: 18px; }
.detail-panel.empty { color: var(--muted); padding: 60px 20px 0; text-align: center; }
.detail-name { font-family: 'Fraunces', Georgia, serif; font-size: 22px; font-weight: 600; color: var(--ink); margin-bottom: 4px; letter-spacing: -0.01em; }
.detail-code { font-size: 11px; color: var(--muted); margin-bottom: 18px; }
.detail-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px dashed var(--line); }
.detail-row:last-child { border-bottom: 0; }
.detail-row .k { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; }
.detail-row .v { color: var(--text); font-variant-numeric: tabular-nums; text-align: right; }

.legend {
  position: absolute; bottom: 56px; left: 16px;
  background: var(--overlay-strong); backdrop-filter: blur(12px);
  border: 1px solid var(--line); border-radius: 6px;
  padding: 12px 14px; z-index: 500; font-size: 11px; max-width: 290px;
  display: none;
}
.legend.open { display: block; }
.legend strong { color: var(--ink); display: block; margin-bottom: 6px; font-size: 11.5px; font-family: 'Fraunces', serif; }
.legend .l-row { color: var(--muted); margin-top: 4px; line-height: 1.5; }

.fineprint {
  position: absolute; bottom: 56px; right: 16px;
  background: var(--overlay-soft); backdrop-filter: blur(8px);
  border: 1px solid var(--line); border-radius: 6px;
  padding: 9px 12px; font-size: 10px; color: var(--muted);
  z-index: 500; max-width: 380px; line-height: 1.6; text-align: right;
  display: none;
}
.fineprint.open { display: block; }
.fineprint a { color: var(--text); text-decoration: none; border-bottom: 1px dotted var(--muted); }
.fineprint a:hover { color: var(--accent-2); border-color: var(--accent-2); }

.icon-btn {
  position: absolute; bottom: 16px;
  width: 32px; height: 32px;
  display: inline-flex; align-items: center; justify-content: center;
  background: var(--overlay-strong); backdrop-filter: blur(8px);
  border: 1px solid var(--line); border-radius: 6px;
  color: var(--text); font-size: 14px; cursor: pointer; z-index: 501;
  transition: background 0.15s, border-color 0.15s, color 0.15s;
}
.icon-btn:hover { background: var(--bg-3); border-color: var(--accent-2); color: var(--accent-2); }
.icon-btn.active { border-color: var(--ui-accent); color: var(--ui-accent); }
.icon-btn.legend-toggle { left: 16px; }
.icon-btn.fineprint-toggle { right: 16px; }

.zoom-readout {
  position: absolute; bottom: 16px; left: 56px;
  background: var(--overlay-soft); backdrop-filter: blur(8px);
  border: 1px solid var(--line); border-radius: 6px;
  padding: 6px 10px; z-index: 500;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px; color: var(--text);
  font-variant-numeric: tabular-nums;
  display: inline-flex; align-items: center; gap: 8px;
  pointer-events: none;
}
.zoom-readout .k { color: var(--muted); font-size: 9px; text-transform: uppercase; letter-spacing: 0.1em; }
.zoom-readout .v { color: var(--accent-2); font-weight: 600; }

.hover-info {
  position: absolute; bottom: 16px; right: 56px;
  background: var(--overlay-strong); backdrop-filter: blur(12px);
  border: 1px solid var(--line); border-radius: 6px;
  padding: 6px 10px; z-index: 500;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px; color: var(--text);
  display: inline-flex; align-items: center; gap: 6px;
  pointer-events: none;
  max-width: calc(100% - 100px);
  white-space: nowrap;
  overflow: hidden; text-overflow: ellipsis;
  opacity: 0; transition: opacity 0.12s;
}
.hover-info.visible { opacity: 1; }
.hover-info .seg { display: inline-flex; align-items: baseline; gap: 5px; }
.hover-info .k { color: var(--muted); font-size: 9px; text-transform: uppercase; letter-spacing: 0.1em; }
.hover-info .v { color: var(--ink); font-weight: 500; }
.hover-info .sep { color: var(--muted); margin: 0 4px; opacity: 0.6; }
.hover-info .v-zup { color: var(--accent-2); }
.hover-info .v-jls { color: var(--ink); }
.hover-info .v-nas { color: var(--ui-accent); }

.controls {
  position: absolute; top: 16px; right: 16px;
  display: flex; flex-direction: column; gap: 6px; z-index: 500;
}
.ctrl-btn {
  padding: 9px 13px;
  background: var(--overlay-strong);
  backdrop-filter: blur(8px);
  border: 1px solid var(--line);
  border-radius: 6px;
  color: var(--text);
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  cursor: pointer;
  transition: background 0.15s, border-color 0.15s;
  text-align: left;
  display: flex; align-items: center; gap: 8px;
  min-width: 200px;
}
.ctrl-btn:hover { background: var(--bg-3); border-color: var(--accent-2); }
.ctrl-btn.active { border-color: var(--ui-accent); color: var(--ui-accent); }
.ctrl-btn .key { font-size: 9px; opacity: 0.5; margin-left: auto; }

.loading {
  position: fixed; inset: 0;
  background: var(--bg); z-index: 10000;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Fraunces', serif;
  font-size: 18px; color: var(--ink);
  flex-direction: column; gap: 16px;
}
.loading.gone { display: none; }
.spinner {
  width: 32px; height: 32px;
  border: 3px solid var(--line);
  border-top-color: var(--ui-accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.maplibregl-popup-content {
  background: var(--popup-bg) !important;
  backdrop-filter: blur(12px);
  border: 1px solid var(--line) !important;
  border-radius: 6px !important;
  padding: 12px 14px !important;
  color: var(--text) !important;
  box-shadow: var(--popup-shadow) !important;
  font-size: 11px;
}
.maplibregl-popup-tip { display: none !important; }

.club-popup { min-width: 240px; }
.club-popup .club-head { display: flex; gap: 10px; align-items: flex-start; margin-bottom: 8px; }
.club-popup .club-logo { width: 44px; height: 44px; object-fit: contain; background: rgba(255,255,255,0.06); border-radius: 4px; padding: 3px; flex-shrink: 0; }
.club-popup .club-title { min-width: 0; flex: 1; }
.club-popup .club-name { font-weight: 600; font-size: 13px; color: var(--ink); line-height: 1.25; margin-bottom: 3px; }
.club-popup .club-league { font-size: 10.5px; color: var(--muted); }
.club-popup .club-row { display: flex; justify-content: space-between; gap: 10px; padding: 4px 0; border-top: 1px dashed var(--line); font-size: 11px; }
.club-popup .club-row .k { color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; font-size: 9.5px; padding-top: 2px; }
.club-popup .club-row .v { color: var(--text); text-align: right; }
.club-popup .club-links { margin-top: 8px; padding-top: 6px; border-top: 1px dashed var(--line); font-size: 11px; }
.club-popup .club-links a { color: var(--accent-2); text-decoration: none; }
.club-popup .club-links a:hover { text-decoration: underline; }
.club-popup .club-details-btn {
  display: block; margin-top: 10px; padding: 7px 10px;
  background: var(--bg-3); color: var(--ink); border: 1px solid var(--line);
  border-radius: 4px; text-align: center; font-size: 11px; cursor: pointer;
  font-family: inherit; width: 100%; transition: all 0.15s;
}
.club-popup .club-details-btn:hover { background: var(--accent-2); color: #fff; border-color: var(--accent-2); }

/* Rich-card modal — opens on "Sve detalje" button click in popup */
.club-modal-backdrop {
  position: fixed; inset: 0; background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(4px); z-index: 999;
  display: none; align-items: center; justify-content: center;
}
.club-modal-backdrop.open { display: flex; }
.club-modal {
  background: var(--bg-2); border: 1px solid var(--line); border-radius: 8px;
  max-width: 560px; width: calc(100% - 32px); max-height: calc(100vh - 64px);
  overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.5);
  scrollbar-width: thin; scrollbar-color: var(--line) transparent;
}
.club-modal .cm-head {
  display: flex; gap: 14px; align-items: center; padding: 18px 20px 14px;
  border-bottom: 1px solid var(--line); position: sticky; top: 0;
  background: var(--bg-2); z-index: 2;
}
.club-modal .cm-logo {
  width: 56px; height: 56px; object-fit: contain;
  background: rgba(255,255,255,0.08); border-radius: 6px; padding: 4px; flex-shrink: 0;
}
.club-modal .cm-title { flex: 1; min-width: 0; }
.club-modal .cm-name { font-size: 16px; font-weight: 600; color: var(--ink); line-height: 1.25; }
.club-modal .cm-short { font-size: 11px; color: var(--muted); margin-top: 3px; }
.club-modal .cm-close {
  background: transparent; border: 1px solid var(--line); color: var(--muted);
  border-radius: 4px; padding: 4px 9px; cursor: pointer; font-family: inherit;
  font-size: 16px; line-height: 1; transition: all 0.15s;
}
.club-modal .cm-close:hover { background: var(--bg-3); color: var(--ink); }
.club-modal .cm-section { padding: 14px 20px; border-bottom: 1px solid var(--line); }
.club-modal .cm-section:last-child { border-bottom: 0; }
.club-modal .cm-section h3 {
  font-size: 10px; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.08em; color: var(--muted); margin: 0 0 10px;
}
.club-modal .cm-row {
  display: flex; justify-content: space-between; gap: 12px;
  padding: 5px 0; font-size: 12px; align-items: flex-start;
}
.club-modal .cm-row .k {
  color: var(--muted); font-size: 10.5px; text-transform: uppercase;
  letter-spacing: 0.04em; flex-shrink: 0; min-width: 90px;
}
.club-modal .cm-row .v { color: var(--text); text-align: right; word-break: break-word; }
.club-modal .cm-row .v a { color: var(--accent-2); text-decoration: none; }
.club-modal .cm-row .v a:hover { text-decoration: underline; }
.club-modal .cm-tag {
  display: inline-block; padding: 1px 6px; border-radius: 3px;
  background: var(--bg-3); border: 1px solid var(--line);
  font-size: 9.5px; color: var(--muted); margin-left: 5px;
  text-transform: uppercase; letter-spacing: 0.05em;
}
.club-modal .cm-tier-chip {
  display: inline-block; padding: 2px 8px; border-radius: 3px;
  font-size: 10px; font-weight: 600; color: #fff;
}
.club-modal .cm-league-block { margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px dashed var(--line); }
.club-modal .cm-league-block:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: 0; }
.club-modal .cm-league-name { font-size: 12px; color: var(--ink); margin-bottom: 4px; }
.club-modal .cm-season-pill {
  display: inline-block; padding: 2px 7px; margin: 2px 4px 2px 0;
  font-size: 10px; background: var(--bg-3); border: 1px solid var(--line);
  border-radius: 10px; color: var(--text); font-variant-numeric: tabular-nums;
}
.club-modal .cm-socials { display: flex; gap: 8px; flex-wrap: wrap; }
.club-modal .cm-socials a {
  padding: 6px 12px; background: var(--bg-3); border: 1px solid var(--line);
  border-radius: 4px; color: var(--text); font-size: 11px; text-decoration: none;
  transition: all 0.15s;
}
.club-modal .cm-socials a:hover { background: var(--accent-2); color: #fff; border-color: var(--accent-2); }
.club-modal .cm-aliases-list { display: flex; flex-wrap: wrap; gap: 5px; }
.club-modal .cm-empty { color: var(--muted); font-style: italic; font-size: 11px; }
</style>
</head>
<body>

<div class="loading" id="loading">
  <div class="spinner"></div>
  <div>Učitavam __NJLS__ JLS...</div>
</div>

